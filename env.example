# Strezz Configuration
# Copy this file to .env and update values as needed

# Target Application
TARGET_URL=https://example.com
TARGET_FRAMEWORK=laravel
TARGET_AUTH=sanctum

# k6 Configuration
K6_VUS=10
K6_DURATION=30s
K6_RAMP_UP=10s
K6_THRESHOLD_P95=500
K6_THRESHOLD_ERROR_RATE=1

# Authentication
AUTH_USERNAME=test@example.com
AUTH_PASSWORD=password123
AUTH_CLIENT_ID=your_client_id
AUTH_CLIENT_SECRET=your_client_secret

# API Configuration
API_BASE_URL=https://api.example.com
API_VERSION=v1
API_TIMEOUT=30000

# Test Scenarios
SCENARIO_TYPE=smoke
SCENARIO_CUSTOM_FILE=
SCENARIO_TAGS=api,smoke

# Output Configuration
OUTPUT_DIR=dist/
OUTPUT_FORMAT=json
OUTPUT_INFLUXDB=false

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
CORRELATION_ID_HEADER=X-Correlation-ID

# Locust (Deprecated - for transition period only)
LOCUST_ENABLED=false
LOCUST_HOST=http://localhost:8089
LOCUST_USERS=10
LOCUST_SPAWN_RATE=1

# Development
NODE_ENV=development
DEBUG=false
