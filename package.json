{
  "name": "strezz",
  "version": "0.1.1",
  "author": "abdoutelb",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "strezz": "bin/strezz.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --ci --collect-coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "build": "node scripts/build.js",
    "clean": "rimraf dist/",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "codecov": "^3.8.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.0.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "got": "^11.8.6",
    "js-yaml": "^4.1.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0"
  },
  "overrides": {
    "jest": {
      "globals": {
        "ts-jest": {
          "useESM": true
        }
      }
    }
  }
}
