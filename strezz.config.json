{
  "target": {
    "url": "https://example.com",
    "framework": "laravel",
    "auth": "sanctum",
    "baseURL": "https://api.example.com",
    "version": "v1",
    "timeout": 30000
  },
  "k6": {
    "defaults": {
      "vus": 10,
      "duration": "30s",
      "rampUp": "10s",
      "thresholds": {
        "http_req_duration": "p(95)<500",
        "http_req_failed": "rate<1%"
      }
    },
    "scenarios": {
      "smoke": {
        "executor": "constant-vus",
        "vus": 1,
        "duration": "30s"
      },
      "load": {
        "executor": "ramping-vus",
        "startVUs": 0,
        "stages": [
          { "duration": "2m", "target": 10 },
          { "duration": "5m", "target": 10 },
          { "duration": "2m", "target": 0 }
        ]
      },
      "stress": {
        "executor": "ramping-arrival-rate",
        "startRate": 10,
        "timeUnit": "1s",
        "stages": [
          { "duration": "2m", "target": 50 },
          { "duration": "5m", "target": 50 },
          { "duration": "2m", "target": 100 },
          { "duration": "5m", "target": 100 },
          { "duration": "2m", "target": 0 }
        ]
      },
      "spike": {
        "executor": "constant-arrival-rate",
        "rate": 100,
        "timeUnit": "1s",
        "duration": "1m"
      },
      "soak": {
        "executor": "constant-vus",
        "vus": 10,
        "duration": "1h"
      }
    }
  },
  "auth": {
    "laravel": {
      "sanctum": {
        "loginEndpoint": "/api/auth/login",
        "tokenHeader": "Authorization",
        "tokenPrefix": "Bearer",
        "refreshEndpoint": "/api/auth/refresh"
      },
      "jwt": {
        "loginEndpoint": "/api/auth/login",
        "tokenHeader": "Authorization",
        "tokenPrefix": "Bearer",
        "refreshEndpoint": "/api/auth/refresh"
      }
    },
    "yii": {
      "csrf": {
        "tokenEndpoint": "/site/csrf",
        "tokenHeader": "X-CSRF-Token",
        "tokenCookie": "_csrf"
      }
    }
  },
  "output": {
    "directory": "dist/",
    "format": "json",
    "influxdb": false,
    "tags": ["api", "generated"]
  },
  "observability": {
    "logging": {
      "level": "info",
      "format": "json"
    },
    "metrics": {
      "enabled": true,
      "prometheus": false
    },
    "correlation": {
      "header": "X-Correlation-ID",
      "enabled": true
    }
  },
  "locust": {
    "enabled": false,
    "deprecated": true,
    "host": "http://localhost:8089",
    "users": 10,
    "spawnRate": 1
  }
}
